# Local developer secrets for Taskfile tasks. Copy to .env and fill in.
# .env is gitignored — never commit real credentials.
#
# Loaded automatically by Task (see `dotenv:` in Taskfile.yaml).

# GitHub username and a personal access token with the read:packages scope.
# Used by `task uat:consensus:ghcr-creds` to create a ghcr.io image-pull secret
# so consensus pods can pull the private solo-operator UC sidecar image.
GITHUB_USER=
GITHUB_ACCESS_TOKEN=
